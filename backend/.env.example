# GuardianAI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: private key of the agent wallet that holds GuardianCap
# Accepts Sui bech32 (suiprivkey1...), hex with 0x prefix, or raw hex
AGENT_PRIVATE_KEY=suiprivkey1...

# Required: object IDs generated during guardian initialisation
# These are unique to your protocol deployment — do not use the demo IDs
PACKAGE_ID=0x...
PROTOCOL_ID=0x...
ACTION_LOG_ID=0x...
GUARDIAN_CONFIG_ID=0x...
GUARDIAN_CAP_ID=0x...

# Optional: Sui network and server settings (defaults shown)
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
PORT=3000
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space

# Optional: protocol integration — override when integrating into your own contract.
# Defaults match the guardian_ai::test_protocol reference implementation.
# Set these to your protocol's module and function names — no code changes needed.
PROTOCOL_MODULE=test_protocol
PAUSE_FUNCTION=pause_protocol
TIGHTEN_LTV_FUNCTION=tighten_ltv
POOL_BALANCE_FIELD=pool_balance
LTV_FIELD=ltv_ratio
PAUSED_FIELD=paused
POOL_BASELINE=10000000000000
